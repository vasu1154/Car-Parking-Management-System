<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Admin.master.cs" Inherits="Admin_Admin" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Admin Panel</title>
    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>

    <link rel="stylesheet" type="text/css" href="../Asset/css/bootstrap-5.3.3-dist/css/bootstrap.min.css" />
    <script type="text/javascript" src="../Asset/css/bootstrap-5.3.3-dist/js/bootstrap.min.js"></script>

    <style>
        /* Full Screen Layout */
        html, body {
            font-family: 'Arial', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        /* Navbar */
        .navbar {
            width: 100%;
            padding: 12px 20px;
            background-color: #343a40 !important;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

        /* Page Layout */
        .page-container {
            display: flex;
            height: 100vh;
            padding-top: 56px; /* Prevent navbar overlap */
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: #fff;
            border-right: 2px solid #ddd;
            padding-top: 20px;
            position: fixed;
            left: 0;
            top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto;
        }

        .sidebar .nav-link {
            font-size: 16px;
            color: #343a40;
            padding: 12px 20px;
            margin: 5px 10px;
            border-radius: 6px;
            transition: all 0.3s ease-in-out;
        }

        .sidebar .nav-link:hover {
            background-color: #007bff;
            color: white;
            transform: scale(1.05);
        }

        .sidebar .nav-link.active {
            background-color: #007bff;
            color: white;
            font-weight: bold;
            pointer-events: none; /* Prevent hover effect on active link */
        }

        /* Main Content */
        .content {
            margin-left: 250px;
            flex-grow: 1;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            width: calc(100% - 250px);
            height: calc(100vh - 56px);
            overflow-y: auto;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .sidebar {
                width: 80px;
            }

            .sidebar .nav-link {
                font-size: 14px;
                padding: 10px;
                text-align: center;
            }

            .sidebar .nav-link span {
                display: none;
            }

            .content {
                margin-left: 80px;
                width: calc(100% - 80px);
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navbar -->
        <nav class="navbar navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="Dashboard.aspx">🚗 Car Parking Admin</a>
                <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-danger" OnClick="btnLogout_Click">Logout</asp:LinkButton>
            </div>
        </nav>

        <!-- Page Wrapper -->
        <div class="page-container">
            <!-- Sidebar -->
            <div class="sidebar bg-light">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="Dashboard.aspx">📊 Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="ManageSlots.aspx">🅿️ Manage Slots</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="ManageBookings.aspx">📅 Manage Bookings</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="ManageUsers.aspx">👤 Manage Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="Reports.aspx">📊 Reports</a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="content p-4">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
</body>
</html>
